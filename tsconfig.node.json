{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],

    "module": "ESNext",
    "moduleResolution": "bundler",

    "strict": true,
    "skipLibCheck": true,

    "jsx": "react-jsx",

    "allowImportingTsExtensions": true,
    "noEmit": true,

    "types": ["vite/client"]
  },
  "include": ["src"]
}